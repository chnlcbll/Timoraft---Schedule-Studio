{
  "manifest_version": 3,
  "name": "Timoraft — Schedule Studio",
  "short_name": "Timoraft",
  "description": "Build, merge, save, and turn class schedules into custom wallpapers.",
  "version": "1.7.0",
  "minimum_chrome_version": "111",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Timoraft"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://archershub.dlsu.edu.ph/*"
  ]
}
